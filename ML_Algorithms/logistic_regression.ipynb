    "import numpy as np\n",
    "\n",
    "def sigmoid(z):\n",
    "    return 1/(1 + np.exp(-z))\n",
    "\n",
    "y = np.array([-3,-2,-1,0,1,2,3])\n",
    "\n",
    "print(sigmoid(y) * 100)\n",
    "\n",
    "\n"
   ]
